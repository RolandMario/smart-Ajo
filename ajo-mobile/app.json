{
  "expo": {
    "name": "SmartThrift",
    "slug": "AJo-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SmartThrift.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartenv.ajo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Allow SmartThrift to use your contacts for airtime and data top-ups."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EF",
        "foregroundImage": "./assets/SmartThrift.png",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "package": "com.smartenv.ajo"
    },
    "web": {
      "favicon": "./assets/SmartThrift.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F3"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fc2f1dd9-9b89-4ab5-9169-6fee882de278"
      }
    }
  }
}
