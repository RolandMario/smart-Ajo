NODE_ENV=development
PORT=5010

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vtu?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=7d

# Termii (https://termii.com)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=OE Alert
TERMII_BASE_URL=https://v4.api.termii.com

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_BASE_URL=https://api.paystack.co
# Transfer OTP used to finalize test-mode withdrawals. Paystack sends the OTP
# to the email/phone registered on the dashboard account — if the default
# (123456) is rejected with "OTP could not be verified", set it to the code
# Paystack actually sends you.
PAYSTACK_TRANSFER_OTP=123456
# Dedicated Virtual Account (DVA) — lets members fund their wallet by bank
# transferring into a personal virtual account number, auto-credited via the
# `charge.success` webhook. Requires DVA to be enabled on the Paystack
# business (Settings > Payment channels), and the webhook URL registered there:
#   https://<your-host>/webhooks/paystack
# Values are Paystack `provider_slug`s, NOT bank names: wema-bank (live),
# titan-paystack, providus, sterling. Wema is live-only — in test mode Paystack
# only accepts providus/sterling, so the server checks
# /dedicated_account/available_providers and falls back automatically.
PAYSTACK_DVA_PREFERRED_BANK=wema-bank

# Firebase Admin SDK (push notifications). Optional in development — if
# omitted, push notifications are skipped and only SMS/in-app entries are
# recorded. Get these from Firebase Console > Project Settings > Service
# Accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OTP behaviour
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cron jobs (Vercel Cron — see vercel.json)
# Vercel sends this exact value as `Authorization: Bearer <CRON_SECRET>` on every
# cron request to the /cron/* endpoints, which verify it. The SAME value must
# exist here (server env) AND in the Vercel project env vars.
# Generate a value with:  openssl rand -hex 32   (Vercel recommends >= 16 chars)
CRON_SECRET=generate-this-with-openssl-rand-hex-32
# Set to 'true' only when Vercel Cron drives the jobs (serverless) — otherwise
# the in-process @nestjs/schedule jobs ALSO fire, causing duplicate debits.
# Keep 'false' on an always-on host where the in-process scheduler is the only trigger.
DISABLE_IN_PROCESS_CRONS=false

# Used only by `npm run seed:platform-admin`
SEED_PLATFORM_ADMIN_EMAIL=admin@ajo.app
SEED_PLATFORM_ADMIN_PASSWORD=change-this-strong-password
SEED_PLATFORM_ADMIN_PHONE=+2347068497569


# ── VTpass (bill payments: airtime, data, cable TV, electricity) ─────────────
# VTpass is the ONLY bills provider. Get the three keys from the VTpass
# dashboard (https://vtpass.com → API Keys): `api-key` is sent on every
# request, `public-key` on GETs (catalogue/balance) and `secret-key` on POSTs
# (vending + customer verification).
#
# Bill purchases answer 503 with the missing variable names when any of the
# three is blank — they are deliberately NOT hardcoded anywhere in src/, so a
# revoked key can never be silently reused.
VTPASS_BASE_URL=https://vtpass.com/api/
VTPASS_API_KEY=55e5a3a8edce6f92723a167859022d26
VTPASS_PUBLIC_KEY=your-vtpass-public-key
VTPASS_SECRET_KEY=your-vtpass-secret-key